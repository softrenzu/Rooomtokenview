{
  "manifest_version": 3,
  "name": "Rooom Token View",
  "version": "0.2.0",
  "description": "GPT Work、ChatGPT、Claudeのプラン使用量を、ブラウザ上でひと目で確認するローカル専用メーター。",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Rooom Token View",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/shared/usage-parser.js", "src/content/chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/shared/usage-parser.js", "src/content/claude.js"],
      "run_at": "document_idle"
    }
  ]
}
